@inherits LayoutComponentBase

<header class="sticky top-0 z-10 border-b border-slate-200 bg-white/80 backdrop-blur">
    <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
        <NavLink href="" Match="NavLinkMatch.All" class="text-lg font-bold tracking-tight text-indigo-600">CVTailr</NavLink>
        <div class="flex items-center gap-1">
            <NavLink href="jd"
               class="rounded-md px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-indigo-50 hover:text-indigo-600">
                New JD
            </NavLink>
            <NavLink href="cv/upload"
               class="rounded-md px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-indigo-50 hover:text-indigo-600">
                Upload CV
            </NavLink>
            <AuthorizeView>
                <Authorized>
                    <div class="ml-2 flex items-center gap-3 border-l border-slate-200 pl-3">
                        <span class="text-sm font-medium text-slate-700">
                            @(context.User.Identity?.Name ?? "Account")
                        </span>

                        <form action="/authentication/logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="/" />

                            <button type="submit"
                                    class="rounded-md px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-indigo-50 hover:text-indigo-600">
                                Sign out
                            </button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </nav>
</header>

@Body

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
