@inherits LayoutComponentBase

<header class="sticky top-0 z-10 border-b border-slate-200 bg-white/80 backdrop-blur">
    <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
        <NavLink href="" Match="NavLinkMatch.All" class="text-lg font-bold tracking-tight text-indigo-600">CVTailr</NavLink>
        <div class="flex items-center gap-2">
            <NavLink href="#how-it-works"
               class="hidden rounded-md px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-indigo-50 hover:text-indigo-600 sm:inline-block">
                How it works
            </NavLink>
            <a href="/authentication/login?returnUrl=/dashboard" data-enhance-nav="false"
               class="rounded-md px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-indigo-50 hover:text-indigo-600">
                Log in
            </a>
        </div>
    </nav>
</header>

@Body

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>