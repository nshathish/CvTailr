@* A prepare/tailor choice card: title, description, a row of step pills, a muted detail
   line, and an action link styled as a button. Used by the job-scoped score page's
   "what would you like to do next" choice between preparing first and tailoring now. *@

<div class="@GetBorderClass() flex h-full flex-col rounded-2xl bg-white p-7 shadow-sm">
    <div class="flex items-start justify-between gap-3">
        <h3 class="font-space-grotesk text-[22px] font-semibold text-slate-900">@Title</h3>
        @if (IsRecommended)
        {
            <span class="shrink-0 rounded-full bg-[#5B4FE0] px-3 py-1 text-xs font-semibold text-white">Recommended</span>
        }
    </div>

    <p class="mt-2 text-sm text-slate-600">@Description</p>

    <div class="mt-4 flex flex-wrap items-center gap-2 font-jetbrains-mono text-[11px] font-medium">
        @for (var i = 0; i < Steps.Count; i++)
        {
            <span class="@GetStepPillClass() rounded-full px-2.5 py-1">@Steps[i]</span>
            @if (i < Steps.Count - 1)
            {
                <span class="text-slate-400">→</span>
            }
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Detail))
    {
        <p class="mt-3 text-xs text-slate-500">@Detail</p>
    }

    <NavLink href="@ActionHref"
             class="@($"{GetActionClass()} mt-6 flex min-h-12 w-full items-center justify-center rounded-lg px-4 text-sm font-semibold transition-colors")">
        @ActionText
    </NavLink>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyList<string> Steps { get; set; } = Array.Empty<string>();
    [Parameter] public string? Detail { get; set; }
    [Parameter, EditorRequired] public string ActionText { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ActionHref { get; set; } = string.Empty;
    [Parameter] public bool IsRecommended { get; set; }
    [Parameter] public bool IsPrimary { get; set; }

    private string GetBorderClass() => IsRecommended
        ? "border-2 border-[#5B4FE0]"
        : "border border-[#E4E6EE]";

    private string GetStepPillClass() => IsRecommended
        ? "bg-[#EEECFD] text-[#3F34C4]"
        : "bg-[#F1F2F6] text-[#3B4152]";

    private string GetActionClass() => IsPrimary
        ? "bg-[#5B4FE0] text-white hover:bg-[#4A3FD0]"
        : "border-[1.5px] border-[#5B4FE0] text-[#4A3FD0] hover:bg-[#EEECFD]";
}
