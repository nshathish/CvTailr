@* Reusable confirmation modal — call ConfirmAsync(...) and await the result instead of
   wiring up parameter-driven visibility, so call sites read like the browser confirm()
   this replaces. One shared instance per page (<ConfirmDialog @ref="..." />). *@

@if (_isOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4" @onclick="Cancel">
        <div class="w-full max-w-sm rounded-xl bg-white p-6 shadow-lg" @onclick:stopPropagation="true">
            <h2 class="text-lg font-semibold text-slate-900">@_title</h2>
            <p class="mt-2 text-sm text-slate-600">@_message</p>

            <div class="mt-6 flex items-center justify-end gap-3">
                <button type="button"
                   @onclick="Cancel"
                   class="text-sm font-medium text-slate-600 hover:text-slate-900">
                    Cancel
                </button>
                <button type="button"
                   @onclick="Confirm"
                   class="@(_danger
                        ? "bg-red-600 hover:bg-red-500"
                        : "bg-indigo-600 hover:bg-indigo-500") inline-flex items-center rounded-md px-4 py-2 text-sm font-medium text-white shadow-sm">
                    @_confirmLabel
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isOpen;
    private string _title = string.Empty;
    private string _message = string.Empty;
    private string _confirmLabel = "Delete";
    private bool _danger = true;
    private TaskCompletionSource<bool>? _tcs;

    public async Task<bool> ConfirmAsync(
        string title, string message,
        string confirmLabel = "Delete", bool danger = true)
    {
        _title = title;
        _message = message;
        _confirmLabel = confirmLabel;
        _danger = danger;
        _isOpen = true;
        _tcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return await _tcs.Task;
    }

    private void Confirm()
    {
        _isOpen = false;
        _tcs?.SetResult(true);
    }

    private void Cancel()
    {
        _isOpen = false;
        _tcs?.SetResult(false);
    }
}
