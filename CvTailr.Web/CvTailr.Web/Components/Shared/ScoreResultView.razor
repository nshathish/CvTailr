@* Renders a Job's MatchScoreResult (overall score ring, rationale, missing must-haves,
   requirement breakdown). Shared between the standalone /score route and the
   New Job wizard's "Match & score" step so there's one source of truth for this markup. *@

@if (Job.MatchScoreResult is { } score)
{
    <div class="space-y-4 rounded-md border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center gap-4">
            <div class="@GetScoreRingClass(score.OverallScorePercent) flex h-20 w-20 shrink-0 items-center justify-center rounded-full border-4 text-xl font-bold">
                @score.OverallScorePercent%
            </div>
            <p class="text-sm text-slate-700">@score.Rationale</p>
        </div>
    </div>

    var missingMustHaves = score.RequirementMatches
        .Where(m => !m.IsMet && GetPriority(m.RequirementId) == RequirementPriority.MustHave)
        .ToList();

    @if (missingMustHaves.Count > 0)
    {
        <div class="mt-4 space-y-2 rounded-md border border-red-300 bg-red-50 p-4">
            <h2 class="text-sm font-semibold text-red-900">Missing must-haves</h2>
            <div class="space-y-2">
                @foreach (var match in missingMustHaves)
                {
                    <div class="rounded-md border border-red-200 bg-white p-3">
                        <p class="text-sm font-medium text-slate-900">@match.Skill</p>
                        @if (!string.IsNullOrWhiteSpace(match.GapNote))
                        {
                            <p class="mt-1 text-xs text-slate-600">@match.GapNote</p>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <div class="mt-4 space-y-2">
        <h2 class="text-sm font-medium text-slate-700">Requirement breakdown</h2>
        <div class="space-y-2">
            @foreach (var match in score.RequirementMatches)
            {
                <div class="flex items-start gap-3 rounded-md border border-slate-100 p-3">
                    <div class="flex shrink-0 flex-col items-start gap-1">
                        <span class="@GetPriorityBadgeClass(GetPriority(match.RequirementId)) rounded-full px-2 py-0.5 text-xs font-medium">
                            @(GetPriority(match.RequirementId) == RequirementPriority.MustHave ? "Must have" : "Nice to have")
                        </span>
                        <span class="@GetMetBadgeClass(match.IsMet) rounded-full px-2 py-0.5 text-xs font-medium">
                            @(match.IsMet ? "Met" : "Not met")
                        </span>
                    </div>
                    <div class="min-w-0">
                        <p class="text-sm font-medium text-slate-900">@match.Skill</p>
                        <p class="text-xs text-slate-500">Confidence: @match.Confidence%</p>
                        @if (!string.IsNullOrWhiteSpace(match.SupportingEvidence))
                        {
                            <p class="mt-1 text-xs text-slate-600">@match.SupportingEvidence</p>
                        }
                        @if (!match.IsMet && !string.IsNullOrWhiteSpace(match.GapNote))
                        {
                            <p class="mt-1 text-xs text-slate-600">@match.GapNote</p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="mt-4">
        <NavLink href="@($"jobs/{Job.Id}/tailor")"
           class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500">
            Tailor my CV to this job
        </NavLink>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Job Job { get; set; } = null!;

    private RequirementPriority GetPriority(string requirementId) =>
        Job.JdRequirements.Requirements.FirstOrDefault(r => r.Id == requirementId)?.Priority
            ?? RequirementPriority.NiceToHave;

    private static string GetPriorityBadgeClass(RequirementPriority priority) => priority switch
    {
        RequirementPriority.MustHave => "bg-red-100 text-red-800",
        RequirementPriority.NiceToHave => "bg-emerald-100 text-emerald-800",
        _ => "bg-slate-100 text-slate-800"
    };

    private static string GetMetBadgeClass(bool isMet) => isMet
        ? "bg-emerald-100 text-emerald-800"
        : "bg-slate-200 text-slate-700";

    private static string GetScoreRingClass(int scorePercent) => scorePercent switch
    {
        >= 80 => "border-emerald-500 text-emerald-700",
        >= 50 => "border-amber-500 text-amber-700",
        _ => "border-red-500 text-red-700"
    };
}
