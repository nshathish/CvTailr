@page "/login"

<PageTitle>Log in – CVTailr</PageTitle>

<section class="flex min-h-[calc(100vh-4rem)] items-center justify-center bg-gradient-to-b from-indigo-50 via-white to-white px-6 py-16">
    <div class="w-full max-w-sm rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600">CVTailr</p>
        <h1 class="mt-3 text-2xl font-bold tracking-tight text-slate-900">Welcome back</h1>
        <p class="mt-2 text-sm text-slate-600">Sign in with your Microsoft account to continue.</p>

        <button @onclick="SignIn"
                class="mt-8 flex w-full items-center justify-center gap-2 rounded-md bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
            Continue with Microsoft
        </button>

        <p class="mt-6 text-center text-sm text-slate-500">
            New to CVTailr?
            <NavLink class="font-medium text-indigo-600 hover:text-indigo-500" href="signup">Create an account</NavLink>
        </p>
    </div>
</section>

@code {
    private void SignIn()
    {
        // Entra ID JWT bearer auth — wire to your chosen sign-in flow, e.g.
        // Microsoft.Identity.Web's RemoteAuthenticatorView, or:
        // NavigationManager.NavigateTo("authentication/login", forceLoad: true);
    }
}