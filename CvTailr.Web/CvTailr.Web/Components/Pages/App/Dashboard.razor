@page "/dashboard"
@rendermode InteractiveServer

@using JobStatus = CvTailr.Web.Services.JobStatus
@using PrepSummary = CvTailr.Web.Services.PrepSummary

@inject IJobsApiClient JobsApiClient
@inject ICvApiClient CvApiClient
@inject NavigationManager NavigationManager

<PageTitle>Your jobs</PageTitle>

<ConfirmDialog @ref="_confirmDialog" />

<div class="mx-auto max-w-6xl px-6 py-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">Your jobs</h1>
            <p class="mt-1 text-sm text-slate-600">Every job description you've parsed, with its latest match score and status.</p>
        </div>

        <NavLink href="jobs/new"
           class="inline-flex shrink-0 items-center gap-1.5 rounded-md bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            New Job
        </NavLink>
    </div>

    @if (_isLoading)
    {
        <p class="mt-8 text-sm text-slate-500">Loading your jobs...</p>
    }
    else if (_errorMessage is not null)
    {
        <div class="mt-8 rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
            <p class="font-medium">Couldn't load your jobs.</p>
            <p class="mt-1">@_errorMessage</p>
        </div>
    }
    else if (_jobs.Count == 0)
    {
        <div class="mt-12 flex flex-col items-center rounded-xl border border-dashed border-slate-300 bg-slate-50 px-6 py-16 text-center">
            <h2 class="text-lg font-semibold text-slate-900">No jobs yet</h2>
            <p class="mt-2 max-w-sm text-sm text-slate-600">
                Paste a job description to get your first match score and see how your CV stacks up.
            </p>
            <NavLink href="jobs/new"
               class="mt-6 inline-flex items-center gap-1.5 rounded-md bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-500">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Create your first job
            </NavLink>
        </div>
    }
    else
    {
        @if (_deleteErrorMessage is not null)
        {
            <div class="mt-8 rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
                <p class="font-medium">Couldn't delete that job.</p>
                <p class="mt-1">@_deleteErrorMessage</p>
            </div>
        }

        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var job in _jobs)
            {
                <div class="relative rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
                    <button type="button"
                       @onclick="() => DeleteJobAsync(job)"
                       title="Delete job"
                       class="absolute right-3 top-3 rounded-md p-1 text-slate-400 hover:bg-red-50 hover:text-red-600">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 7h12M9.5 7V5a1.5 1.5 0 0 1 1.5-1.5h2a1.5 1.5 0 0 1 1.5 1.5v2m-8 0 .7 12.1a2 2 0 0 0 2 1.9h5.6a2 2 0 0 0 2-1.9L18.5 7" />
                        </svg>
                    </button>

                    <div class="flex items-start justify-between gap-4 pr-8">
                        <div class="min-w-0">
                            <h2 class="truncate text-base font-semibold text-slate-900">
                                <NavLink href="@GetActionHref(job)" class="hover:underline">@job.JdRequirements.RoleTitle</NavLink>
                            </h2>
                            @if (!string.IsNullOrWhiteSpace(job.JdRequirements.CompanyName))
                            {
                                <p class="truncate text-xs text-slate-500">@job.JdRequirements.CompanyName</p>
                            }
                        </div>

                        @if (job.MatchScoreResult is not null && !IsScoreStale(job))
                        {
                            <div class="@GetScoreRingClass(job.MatchScoreResult.OverallScorePercent) flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-4 text-sm font-bold">
                                @job.MatchScoreResult.OverallScorePercent%
                            </div>
                        }
                        else if (IsScoreStale(job))
                        {
                            <span class="shrink-0 text-xs font-medium text-amber-700">Needs re-score</span>
                        }
                        else
                        {
                            <span class="shrink-0 text-xs font-medium text-slate-400">Not scored yet</span>
                        }
                    </div>

                    <div class="mt-3">
                        <StatusChip Status="job.Status" />

                        @if (job.Status == JobStatus.Preparing && job.PrepSummary is { } prepSummary)
                        {
                            <div class="mt-2 h-1.5 w-full rounded-full bg-[#E4E6EE]">
                                <div class="h-1.5 rounded-full bg-[#5B4FE0]" style="width: @(GetPrepPercent(prepSummary))%"></div>
                            </div>
                            <p class="mt-1 text-xs text-slate-600">@prepSummary.Ready of @prepSummary.Total ready</p>
                        }
                        else if (job.Status == JobStatus.Tailored)
                        {
                            <p class="mt-1 text-xs text-slate-600">
                                @(job.PrepSummary is { } tailoredPrep
                                    ? $"Prepared · {tailoredPrep.AssessedPassed} skills assessed"
                                    : "Tailored directly")
                            </p>
                        }
                    </div>

                    @if (IsScoreStale(job))
                    {
                        <span class="mt-2 inline-block rounded-full border border-amber-200 bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700">
                            CV updated since scored
                        </span>
                    }

                    <p class="mt-2 text-xs text-slate-500">
                        @if (job.MatchScoreResult is not null && !IsScoreStale(job))
                        {
                            @($"{GetMatchedCount(job.MatchScoreResult)} of {job.MatchScoreResult.RequirementMatches.Count} skills matched · ")
                        }
                        else if (IsScoreStale(job))
                        {
                            @("Score outdated · ")
                        }
                        @job.UpdatedAt.ToString("d MMM yyyy")
                    </p>

                    <div class="mt-4 flex items-center justify-between gap-3 border-t border-[#EEF0F5] pt-3">
                        <span class="text-xs text-slate-500">@GetFooterHint(job.Status)</span>
                        <NavLink href="@GetActionHref(job)" class="inline-flex min-h-9 items-center text-sm font-semibold text-[#4A3FD0]">
                            @GetFooterLinkLabel(job.Status)
                        </NavLink>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _deleteErrorMessage;
    private List<JobSummary> _jobs = new();
    private CvDocument? _cv;
    private ConfirmDialog? _confirmDialog;

    protected override async Task OnInitializedAsync()
    {
        // CV upload lives in exactly one place (cv/upload) — a logged-in user with no CV is sent
        // there before this page renders anything, rather than duplicating an upload prompt here.
        // `cv is null` after a call that didn't throw is the real "no CV" signal; a genuine load
        // failure (caught below) must NOT redirect — it stays best-effort/silent, same as before.
        var cvLoadFailed = false;
        try
        {
            _cv = await CvApiClient.GetCurrentCvAsync();
        }
        catch
        {
            cvLoadFailed = true;
        }

        if (_cv is null && !cvLoadFailed)
        {
            NavigationManager.NavigateTo("cv/upload?reason=required", replace: true);
            return;
        }

        try
        {
            _jobs = await JobsApiClient.GetJobsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeleteJobAsync(JobSummary job)
    {
        var message = string.IsNullOrWhiteSpace(job.JdRequirements.CompanyName)
            ? $"Delete '{job.JdRequirements.RoleTitle}'? This can't be undone."
            : $"Delete '{job.JdRequirements.RoleTitle}' at '{job.JdRequirements.CompanyName}'? This can't be undone.";

        var confirmed = _confirmDialog is not null && await _confirmDialog.ConfirmAsync(
            "Delete job?", message, confirmLabel: "Delete");

        if (!confirmed)
            return;

        _deleteErrorMessage = null;

        try
        {
            await JobsApiClient.DeleteJobAsync(job.Id);
            _jobs.Remove(job);
        }
        catch (Exception ex)
        {
            _deleteErrorMessage = ex.Message;
        }
    }

    // CvId can't detect a since-replaced CV (the master CvDocument's Id is preserved across
    // re-uploads — see CvTailr.Api/docs/010-cv-reparse-bullet-id-churn.md), so this compares
    // timestamps instead. Informational only — never hides or clears the existing score.
    private bool IsScoreStale(JobSummary job) =>
        job.MatchScoreResult is not null && _cv is not null && _cv.UpdatedAt > job.MatchScoreResult.ScoredAt;

    private static int GetMatchedCount(MatchScoreResult result) =>
        result.RequirementMatches.Count(m => m.IsMet);

    private static string GetScoreRingClass(int scorePercent) => scorePercent switch
    {
        >= 80 => "border-emerald-500 text-emerald-700",
        >= 50 => "border-amber-500 text-amber-700",
        _ => "border-red-500 text-red-700"
    };

    // Where the card's title and footer action link both go — a card's next step depends on
    // where the job is in its lifecycle, not a single fixed destination for every card.
    private static string GetActionHref(JobSummary job) => job.Status switch
    {
        JobStatus.Preparing => $"jobs/{job.Id}/prepare",
        JobStatus.Tailored => $"jobs/{job.Id}/cv",
        _ => $"score?jobId={job.Id}"
    };

    private static string GetFooterHint(JobStatus status) => status switch
    {
        JobStatus.Scored => "Prepare or tailor?",
        JobStatus.Preparing => "Preparation in progress",
        _ => ""
    };

    private static string GetFooterLinkLabel(JobStatus status) => status switch
    {
        JobStatus.Preparing => "Continue preparing →",
        JobStatus.Tailored => "View tailored CV →",
        _ => "Choose next step →"
    };

    private static int GetPrepPercent(PrepSummary prep) =>
        prep.Total <= 0 ? 0 : (int)Math.Round(100.0 * prep.Ready / prep.Total);
}
