@page "/dashboard"
@rendermode InteractiveServer

@using System.Globalization
@using CvTailr.Web.Configuration
@using Microsoft.Extensions.Options
@using JobStatus = CvTailr.Web.Services.JobStatus

@inject IJobsApiClient JobsApiClient
@inject IJobListingsApiClient JobListingsApiClient
@inject ICvApiClient CvApiClient
@inject NavigationManager NavigationManager
@inject IOptions<LogoDevOptions> LogoDevOptions
@inject ILogger<Dashboard> Logger

<PageTitle>Your jobs</PageTitle>

<ConfirmDialog @ref="_confirmDialog" />

<div class="mx-auto max-w-6xl px-6 py-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">Your jobs</h1>
            <p class="mt-1 text-sm text-slate-600">Every job description you've parsed, with its latest match score and status.</p>
        </div>

        <NavLink href="jobs/new"
           class="inline-flex shrink-0 items-center gap-1.5 rounded-md bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-500">
            <Blazicon Svg="Lucide.Plus" class="h-4 w-4" aria-hidden="true" />
            New Job
        </NavLink>
    </div>

    @if (_isLoading)
    {
        <p class="mt-8 text-sm text-slate-500">Loading your jobs...</p>
    }
    else if (_errorMessage is not null)
    {
        <div class="mt-8 rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
            <p class="font-medium">Couldn't load your jobs.</p>
            <p class="mt-1">@_errorMessage</p>
        </div>
    }
    else if (_jobs.Count == 0)
    {
        <div class="mt-12 flex flex-col items-center rounded-xl border border-dashed border-slate-300 bg-slate-50 px-6 py-16 text-center">
            <h2 class="text-lg font-semibold text-slate-900">No jobs yet</h2>
            <p class="mt-2 max-w-sm text-sm text-slate-600">
                Paste a job description to get your first match score and see how your CV stacks up.
            </p>
            <NavLink href="jobs/new"
               class="mt-6 inline-flex items-center gap-1.5 rounded-md bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-500">
                <Blazicon Svg="Lucide.Plus" class="h-4 w-4" aria-hidden="true" />
                Create your first job
            </NavLink>
        </div>
    }
    else
    {
        @if (_deleteErrorMessage is not null)
        {
            <div class="mt-8 rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
                <p class="font-medium">Couldn't delete that job.</p>
                <p class="mt-1">@_deleteErrorMessage</p>
            </div>
        }

        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var job in _jobs)
            {
                <div class="flex flex-col gap-5 overflow-hidden rounded-[20px] border border-slate-200 bg-white p-6 shadow-[0_1px_2px_rgba(15,23,42,0.04),0_12px_32px_-12px_rgba(15,23,42,0.18)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_2px_4px_rgba(15,23,42,0.06),0_24px_48px_-16px_rgba(91,79,224,0.35)]">
                    <div class="flex items-start gap-3.5">
                        <CompanyLogo CompanyDomain="job.JdRequirements.CompanyDomain"
                                     CompanyName="job.JdRequirements.CompanyName"
                                     RoleTitle="job.JdRequirements.RoleTitle" />

                        <div class="min-w-0 flex-1">
                            <h2 class="font-space-grotesk line-clamp-2 text-[17px] font-semibold leading-snug text-slate-800" title="@job.JdRequirements.RoleTitle">
                                @job.JdRequirements.RoleTitle
                            </h2>
                            @if (!string.IsNullOrWhiteSpace(job.JdRequirements.CompanyName))
                            {
                                <p class="mt-0.5 text-sm font-normal text-slate-500">@job.JdRequirements.CompanyName</p>
                            }
                        </div>

                        <div class="-mr-2 -mt-1 flex shrink-0 gap-1">
                            <NavLink href="@GetScoreHref(job)"
                               title="View fit score"
                               aria-label="@($"View fit score for {job.JdRequirements.RoleTitle}")"
                               class="flex h-9 w-9 items-center justify-center rounded-[10px] text-slate-400 transition-colors hover:bg-[#EEECFD] hover:text-[#5B4FE0] focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5B4FE0]">
                                <Blazicon Svg="Lucide.Eye" class="h-[18px] w-[18px]" aria-hidden="true" />
                            </NavLink>
                            <button type="button"
                               @onclick="() => DeleteJobAsync(job)"
                               title="Delete job"
                               class="flex h-9 w-9 items-center justify-center rounded-[10px] text-slate-400 transition-colors hover:bg-rose-50 hover:text-rose-600 focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-600">
                                <Blazicon Svg="Lucide.Trash2" class="h-[18px] w-[18px]" aria-hidden="true" />
                            </button>
                        </div>
                    </div>

                    @if (job.MatchScoreResult is { } score)
                    {
                        var total = score.RequirementMatches.Count;
                        var met = GetMatchedCount(score);

                        <section class="flex items-center gap-4 rounded-2xl border border-slate-100 bg-slate-50 p-4"
                                 aria-label="@($"Skill match {score.OverallScorePercent} percent, {met} of {total} skills matched")">
                            <div class="relative h-[68px] w-[68px] shrink-0">
                                <svg class="h-[68px] w-[68px] -rotate-90" viewBox="0 0 68 68">
                                    <circle cx="34" cy="34" r="28" fill="none" stroke="currentColor" stroke-width="7"
                                            class="@GetRingTrackClass(score.OverallScorePercent)" />
                                    <circle cx="34" cy="34" r="28" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round"
                                            stroke-dasharray="175.93" stroke-dashoffset="@GetRingDashOffset(score.OverallScorePercent)"
                                            class="@GetRingArcClass(score.OverallScorePercent)" />
                                </svg>
                                <div class="@GetRingLabelClass(score.OverallScorePercent) absolute inset-0 flex items-center justify-center text-[17px] font-semibold">
                                    @score.OverallScorePercent%
                                </div>
                            </div>

                            <div class="min-w-0 flex-1 space-y-2">
                                <div class="flex items-baseline justify-between gap-2">
                                    <span class="text-sm font-semibold text-slate-700">@GetMatchLabel(score.OverallScorePercent)</span>
                                    <span class="text-[13px] font-normal text-slate-500">@met of @total skills</span>
                                </div>

                                @if (total > 0 && total <= 20)
                                {
                                    <div class="grid gap-[3px]" style="grid-template-columns: repeat(@total, minmax(0, 1fr));" aria-hidden="true">
                                        @foreach (var match in score.RequirementMatches)
                                        {
                                            <span class="@(match.IsMet ? GetSegmentFillClass(score.OverallScorePercent) : "bg-slate-200") h-1.5 rounded-full"></span>
                                        }
                                    </div>
                                }
                                else if (total > 20)
                                {
                                    <div class="h-1.5 w-full rounded-full bg-slate-200" aria-hidden="true">
                                        <div class="@GetSegmentFillClass(score.OverallScorePercent) h-1.5 rounded-full" style="width: @(GetSegmentFillPercent(met, total))%"></div>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                    else
                    {
                        <p class="text-xs font-medium text-slate-400">Not scored yet</p>
                    }

                    <div class="flex items-center justify-between gap-3">
                        <StatusChip Status="job.Status" />

                        <div class="flex items-center gap-1.5 text-[13px] font-normal text-slate-500">
                            <Blazicon Svg="Lucide.Calendar" class="h-[15px] w-[15px] text-slate-400" aria-hidden="true" />
                            <time datetime="@job.CreatedAt.ToString("yyyy-MM-dd")">Added @job.CreatedAt.ToString("d MMM yyyy")</time>
                        </div>
                    </div>

                    <NavLink href="@GetActionHref(job)"
                             class="group/btn flex h-12 items-center justify-center gap-1.5 rounded-[14px] bg-[#5B4FE0] text-[15px] font-semibold text-white shadow-[0_8px_20px_-8px_rgba(91,79,224,0.6)] transition-colors hover:bg-[#4A3FD0] focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5B4FE0]">
                        @GetNextStepLabel(job.Status)
                        <Blazicon Svg="Lucide.ArrowRight" class="h-[18px] w-[18px] transition-transform group-hover/btn:translate-x-0.5" stroke-width="2.25" aria-hidden="true" />
                    </NavLink>
                </div>
            }
        </div>
    }

    @if (!_matchesFailed)
    {
        <div class="mt-12">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <h2 class="font-space-grotesk text-[22px] font-semibold text-slate-900">Open roles matching your skills</h2>
                @if (!_isLoadingMatches && _matches.Count > 0)
                {
                    <NavLink href="discover" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">See all →</NavLink>
                }
            </div>
            <p class="mt-1 text-sm text-slate-500">Shared by other CVTailr users, matched to your CV's skills.</p>

            @if (_isLoadingMatches)
            {
                <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                    @for (var i = 0; i < 3; i++)
                    {
                        <div class="h-[280px] animate-pulse rounded-[20px] border border-slate-200 bg-slate-100"></div>
                    }
                </div>
            }
            else if (_matches.Count == 0)
            {
                <p class="mt-6 text-sm text-slate-500">No matching roles yet. They'll appear as more jobs are shared.</p>
            }
            else
            {
                <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var match in _matches)
                    {
                        <ListingCard Match="match" />
                    }
                </div>
            }
        </div>
    }

    @if (ShowLogoAttribution)
    {
        <a href="https://logo.dev" target="_blank" rel="noopener" class="mt-4 inline-block text-[12px] text-slate-400 hover:text-slate-500">
            Logos by Logo.dev
        </a>
    }
</div>

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _deleteErrorMessage;
    private List<JobSummary> _jobs = new();
    private CvDocument? _cv;
    private ConfirmDialog? _confirmDialog;

    private bool _isLoadingMatches = true;
    private bool _matchesFailed;
    private List<ListingMatch> _matches = new();

    protected override async Task OnInitializedAsync()
    {
        // Fire-and-forget: the matches section loads independently so a slow match request never
        // delays "Your jobs" below. LoadMatchesAsync calls StateHasChanged itself once it settles.
        _ = LoadMatchesAsync();

        // CV upload lives in exactly one place (cv/upload) — a logged-in user with no CV is sent
        // there before this page renders anything, rather than duplicating an upload prompt here.
        // `cv is null` after a call that didn't throw is the real "no CV" signal; a genuine load
        // failure (caught below) must NOT redirect — it stays best-effort/silent, same as before.
        var cvLoadFailed = false;
        try
        {
            _cv = await CvApiClient.GetCurrentCvAsync();
        }
        catch
        {
            cvLoadFailed = true;
        }

        if (_cv is null && !cvLoadFailed)
        {
            NavigationManager.NavigateTo("cv/upload?reason=required", replace: true);
            return;
        }

        try
        {
            _jobs = await JobsApiClient.GetJobsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private const int DashboardMatchesLimit = 6;

    private async Task LoadMatchesAsync()
    {
        try
        {
            _matches = await JobListingsApiClient.GetMatchesAsync(DashboardMatchesLimit);
        }
        catch (Exception ex)
        {
            _matchesFailed = true;
            Logger.LogError(ex, "Failed to load job-listing matches for the dashboard.");
        }
        finally
        {
            _isLoadingMatches = false;
            StateHasChanged();
        }
    }

    private async Task DeleteJobAsync(JobSummary job)
    {
        var message = string.IsNullOrWhiteSpace(job.JdRequirements.CompanyName)
            ? $"Delete '{job.JdRequirements.RoleTitle}'? This can't be undone."
            : $"Delete '{job.JdRequirements.RoleTitle}' at '{job.JdRequirements.CompanyName}'? This can't be undone.";

        var confirmed = _confirmDialog is not null && await _confirmDialog.ConfirmAsync(
            "Delete job?", message, confirmLabel: "Delete");

        if (!confirmed)
            return;

        _deleteErrorMessage = null;

        try
        {
            await JobsApiClient.DeleteJobAsync(job.Id);
            _jobs.Remove(job);
        }
        catch (Exception ex)
        {
            _deleteErrorMessage = ex.Message;
        }
    }

    private bool ShowLogoAttribution =>
        !string.IsNullOrWhiteSpace(LogoDevOptions.Value.PublishableKey) &&
        (_jobs.Any(j => !string.IsNullOrWhiteSpace(j.JdRequirements.CompanyDomain)) ||
         _matches.Any(m => !string.IsNullOrWhiteSpace(m.CompanyDomain)));

    private static int GetMatchedCount(MatchScoreResult result) =>
        result.RequirementMatches.Count(m => m.IsMet);

    private const double RingCircumference = 175.93; // 2π × 28 (r=28)

    private static string GetRingDashOffset(int scorePercent) =>
        (RingCircumference * (1 - scorePercent / 100.0)).ToString("F2", CultureInfo.InvariantCulture);

    // Ring track/arc/label share one colour family per score band; track is the 100-shade,
    // arc and segmented-bar fill are the 500-shade, the centre label is the 700-shade.
    private static string GetRingTrackClass(int scorePercent) => scorePercent switch
    {
        >= 80 => "text-emerald-100",
        >= 50 => "text-amber-100",
        _ => "text-red-100"
    };

    private static string GetRingArcClass(int scorePercent) => scorePercent switch
    {
        >= 80 => "text-emerald-500",
        >= 50 => "text-amber-500",
        _ => "text-red-500"
    };

    private static string GetRingLabelClass(int scorePercent) => scorePercent switch
    {
        >= 80 => "text-emerald-700",
        >= 50 => "text-amber-700",
        _ => "text-red-700"
    };

    private static string GetSegmentFillClass(int scorePercent) => scorePercent switch
    {
        >= 80 => "bg-emerald-500",
        >= 50 => "bg-amber-500",
        _ => "bg-red-500"
    };

    private static string GetMatchLabel(int scorePercent) => scorePercent switch
    {
        >= 85 => "Excellent match",
        >= 70 => "Good match",
        >= 50 => "Fair match",
        _ => "Low match"
    };

    private static int GetSegmentFillPercent(int met, int total) =>
        total <= 0 ? 0 : (int)Math.Round(100.0 * met / total);

    // Where the next-step button (and the eye icon/score ring, via GetScoreHref) send the
    // user — a card's next step depends on where the job is in its lifecycle.
    private static string GetActionHref(JobSummary job) => job.Status switch
    {
        JobStatus.Preparing => $"jobs/{job.Id}/prepare",
        JobStatus.Tailored => $"jobs/{job.Id}/cv",
        _ => $"jobs/{job.Id}/score"
    };

    // Unlike GetActionHref, the eye icon always opens the score page regardless of status —
    // it's a dedicated "view the stored score" affordance.
    private static string GetScoreHref(JobSummary job) => $"jobs/{job.Id}/score";

    private static string GetNextStepLabel(JobStatus status) => status switch
    {
        JobStatus.Preparing => "Continue preparing",
        JobStatus.Tailored => "View tailored CV",
        _ => "Choose next step"
    };
}
