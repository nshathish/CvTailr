@page "/dashboard"
@rendermode InteractiveServer

@inject IJobsApiClient JobsApiClient
@inject ICvApiClient CvApiClient
@inject NavigationManager NavigationManager

<PageTitle>Your jobs</PageTitle>

<div class="mx-auto max-w-6xl px-6 py-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">Your jobs</h1>
            <p class="mt-1 text-sm text-slate-600">Every job description you've parsed, with its latest match score and status.</p>
        </div>

        <NavLink href="jobs/new"
           class="inline-flex shrink-0 items-center gap-1.5 rounded-md bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            New Job
        </NavLink>
    </div>

    @if (_isLoading)
    {
        <p class="mt-8 text-sm text-slate-500">Loading your jobs...</p>
    }
    else if (_errorMessage is not null)
    {
        <div class="mt-8 rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
            <p class="font-medium">Couldn't load your jobs.</p>
            <p class="mt-1">@_errorMessage</p>
        </div>
    }
    else if (_jobs.Count == 0)
    {
        <div class="mt-12 flex flex-col items-center rounded-xl border border-dashed border-slate-300 bg-slate-50 px-6 py-16 text-center">
            <h2 class="text-lg font-semibold text-slate-900">No jobs yet</h2>
            <p class="mt-2 max-w-sm text-sm text-slate-600">
                Paste a job description to get your first match score and see how your CV stacks up.
            </p>
            <NavLink href="jobs/new"
               class="mt-6 inline-flex items-center gap-1.5 rounded-md bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-500">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Create your first job
            </NavLink>
        </div>
    }
    else
    {
        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var job in _jobs)
            {
                <NavLink href="@($"score?jobId={job.Id}")"
                   class="block rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
                    <div class="flex items-start justify-between gap-4">
                        <h2 class="min-w-0 truncate text-base font-semibold text-slate-900">@job.JdRequirements.RoleTitle</h2>

                        @if (job.MatchScoreResult is not null && !IsScoreStale(job))
                        {
                            <div class="@GetScoreRingClass(job.MatchScoreResult.OverallScorePercent) flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-4 text-sm font-bold">
                                @job.MatchScoreResult.OverallScorePercent%
                            </div>
                        }
                        else if (IsScoreStale(job))
                        {
                            <span class="shrink-0 text-xs font-medium text-amber-700">Needs re-score</span>
                        }
                        else
                        {
                            <span class="shrink-0 text-xs font-medium text-slate-400">Not scored yet</span>
                        }
                    </div>

                    <span class="@GetStatusBadgeClass(job.Status) mt-3 inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide">
                        @job.Status
                    </span>

                    @if (IsScoreStale(job))
                    {
                        <span class="ml-2 mt-3 inline-block rounded-full border border-amber-200 bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700">
                            CV updated since scored
                        </span>
                    }

                    <p class="mt-2 text-xs text-slate-500">
                        @if (job.MatchScoreResult is not null && !IsScoreStale(job))
                        {
                            @($"{GetMatchedCount(job.MatchScoreResult)} of {job.MatchScoreResult.RequirementMatches.Count} skills matched · ")
                        }
                        else if (IsScoreStale(job))
                        {
                            @("Score outdated · ")
                        }
                        @job.UpdatedAt.ToString("d MMM yyyy")
                    </p>
                </NavLink>
            }
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private List<Job> _jobs = new();
    private CvDocument? _cv;

    protected override async Task OnInitializedAsync()
    {
        // CV upload lives in exactly one place (cv/upload) — a logged-in user with no CV is sent
        // there before this page renders anything, rather than duplicating an upload prompt here.
        // `cv is null` after a call that didn't throw is the real "no CV" signal; a genuine load
        // failure (caught below) must NOT redirect — it stays best-effort/silent, same as before.
        var cvLoadFailed = false;
        try
        {
            _cv = await CvApiClient.GetCurrentCvAsync();
        }
        catch
        {
            cvLoadFailed = true;
        }

        if (_cv is null && !cvLoadFailed)
        {
            NavigationManager.NavigateTo("cv/upload?reason=required", replace: true);
            return;
        }

        try
        {
            _jobs = await JobsApiClient.GetJobsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    // CvId can't detect a since-replaced CV (the master CvDocument's Id is preserved across
    // re-uploads — see CvTailr.Api/docs/010-cv-reparse-bullet-id-churn.md), so this compares
    // timestamps instead. Informational only — never hides or clears the existing score.
    private bool IsScoreStale(Job job) =>
        job.MatchScoreResult is not null && _cv is not null && _cv.UpdatedAt > job.MatchScoreResult.ScoredAt;

    private static int GetMatchedCount(MatchScoreResult result) =>
        result.RequirementMatches.Count(m => m.IsMet);

    private static string GetScoreRingClass(int scorePercent) => scorePercent switch
    {
        >= 80 => "border-emerald-500 text-emerald-700",
        >= 50 => "border-amber-500 text-amber-700",
        _ => "border-red-500 text-red-700"
    };

    private static string GetStatusBadgeClass(JobStatus status) => status switch
    {
        JobStatus.Scored => "border border-amber-200 bg-amber-50 text-amber-700",
        JobStatus.Tailored => "border border-emerald-200 bg-emerald-50 text-emerald-700",
        _ => "border border-slate-200 bg-slate-100 text-slate-600"
    };
}
