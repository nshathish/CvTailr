@page "/jd"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

@* Superseded by the New Job wizard (task 009) — kept as a redirect so any
   existing links/bookmarks to /jd still land somewhere useful, rather than
   leaving a second, half-duplicated JD-entry flow reachable alongside it. *@

@code {
    protected override void OnInitialized() =>
        NavigationManager.NavigateTo("/jobs/new", replace: true);
}
