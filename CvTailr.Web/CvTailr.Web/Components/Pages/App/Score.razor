@page "/jobs/{JobId}/score"
@rendermode InteractiveServer

@using JobStatus = CvTailr.Shared.Jobs.JobStatus

@inject IJobsApiClient JobsApiClient
@inject ICvApiClient CvApiClient
@inject WorkflowStateService WorkflowState
@inject NavigationManager NavigationManager

<PageTitle>Score</PageTitle>

<div class="mx-auto max-w-4xl px-4 py-8 space-y-6">
    <nav class="font-jetbrains-mono text-[11px] uppercase tracking-wider text-slate-500">
        <NavLink href="dashboard" class="underline hover:text-slate-700">Dashboard</NavLink>
        <span> / Fit score</span>
    </nav>

    @if (_isLoadingJob)
    {
        <p class="text-sm text-slate-500">Loading job...</p>
    }
    else if (_jobLoadError is not null)
    {
        <div class="rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
            <p class="font-medium">Couldn't load that job.</p>
            <p class="mt-1">@_jobLoadError</p>
        </div>
    }
    else if (_jobNotFound)
    {
        <div class="rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
            <p class="font-medium">Job not found</p>
            <NavLink href="dashboard" class="mt-2 inline-block font-medium text-indigo-600 hover:text-indigo-500">
                Back to Dashboard
            </NavLink>
        </div>
    }
    else if (WorkflowState.CurrentJob is { } job)
    {
        <div>
            <h1 class="font-space-grotesk text-[28px] font-semibold text-slate-900">@job.JdRequirements.RoleTitle</h1>
            <p class="mt-1 text-[13px] text-slate-500">@GetScoreSubtitle(job)</p>
        </div>

        @if (job.MatchScoreResult is null)
        {
            <div class="rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
                <p class="font-medium">This job hasn't been scored yet</p>
                <NavLink href="dashboard" class="mt-2 inline-block font-medium text-indigo-600 hover:text-indigo-500">
                    Back to Dashboard
                </NavLink>
            </div>
        }

        @if (IsScoreStale)
        {
            <div class="rounded-md border border-amber-300 bg-amber-50 p-4 text-sm text-amber-800">
                <p class="font-medium">Your CV has been updated since this job was last scored.</p>
                <p class="mt-1">Recommended: re-score to see how your current CV matches.</p>
            </div>
        }

        <ScoreResultView Job="job" ShowTailorButton="false" />

        @if (job.MatchScoreResult is not null)
        {
            var (prepareConfig, tailorConfig) = GetCardConfigs(job);

            <section class="mt-8">
                <h2 class="font-space-grotesk text-xl font-semibold text-slate-900">What would you like to do next?</h2>

                <div class="mt-4 grid grid-cols-1 gap-5 md:grid-cols-2">
                    <ChoiceCard Title="Prepare, then tailor"
                                Description="Learn the skills you're missing, prove them in a short assessment, then tailor your CV with evidence you can defend in the interview."
                                Steps="PrepareSteps"
                                Detail="@PrepareDetail"
                                ActionText="@prepareConfig.ActionText"
                                ActionHref="@prepareConfig.ActionHref"
                                IsHighlighted="prepareConfig.IsHighlighted"
                                BadgeText="@prepareConfig.BadgeText"
                                BadgeTone="prepareConfig.BadgeTone"
                                IsPrimary="prepareConfig.IsPrimary" />

                    <ChoiceCard Title="Tailor now"
                                Description="Go straight to tailored proposals using your CV as it stands. Gaps stay as gaps, and you can still practise for the interview afterwards."
                                Steps="TailorSteps"
                                Detail="Best when your score is already strong or the deadline is close"
                                ActionText="@tailorConfig.ActionText"
                                ActionHref="@tailorConfig.ActionHref"
                                IsHighlighted="tailorConfig.IsHighlighted"
                                BadgeText="@tailorConfig.BadgeText"
                                BadgeTone="tailorConfig.BadgeTone"
                                IsPrimary="tailorConfig.IsPrimary" />
                </div>

                <NavLink href="dashboard" class="mt-6 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500">
                    Back to Dashboard
                </NavLink>
            </section>
        }
    }
</div>

@code {
    private static readonly string[] PrepareSteps = ["LEARN", "ASSESS", "CONFIRM", "TAILOR"];
    private static readonly string[] TailorSteps = ["TAILOR", "PRACTISE LATER"];

    [Parameter]
    public string JobId { get; set; } = string.Empty;

    private bool _isLoadingJob;
    private bool _jobNotFound;
    private string? _jobLoadError;
    private CvDocument? _cv;

    // CvId can't detect a since-replaced CV (the master CvDocument's Id is preserved across
    // re-uploads — see CvTailr.Api/docs/010-cv-reparse-bullet-id-churn.md), so this compares
    // timestamps instead. Informational only — never hides or clears the existing score.
    private bool IsScoreStale =>
        WorkflowState.CurrentJob?.MatchScoreResult is not null
        && _cv is not null
        && _cv.UpdatedAt > WorkflowState.CurrentJob.MatchScoreResult.ScoredAt;

    // "Requirements to work on" = every requirement RequirementClassifier doesn't consider fully
    // Met — i.e. a Gap, Partial, or Met-with-low-confidence (see Services/RequirementClassifier.cs).
    private List<RequirementMatch> RequirementsToWorkOn =>
        WorkflowState.CurrentJob?.MatchScoreResult?.RequirementMatches
            .Where(m => RequirementClassifier.IsToWorkOn(RequirementClassifier.Classify(m)))
            .ToList() ?? [];

    // Recommend preparing first when a Must have requirement isn't fully met, or any met
    // requirement's confidence is below 70% — narrower than RequirementsToWorkOn, which isn't
    // scoped by priority.
    private bool RecommendPrepare
    {
        get
        {
            var job = WorkflowState.CurrentJob;
            if (job?.MatchScoreResult is null)
                return false;

            var mustHaveNotMet = job.MatchScoreResult.RequirementMatches.Any(m =>
                RequirementClassifier.Classify(m) is RequirementState.Gap or RequirementState.Partial
                && GetPriority(job, m.RequirementId) == RequirementPriority.MustHave);
            var metWithLowConfidence = job.MatchScoreResult.RequirementMatches.Any(m =>
                RequirementClassifier.Classify(m) == RequirementState.MetLowConfidence);

            return mustHaveNotMet || metWithLowConfidence;
        }
    }

    private string? PrepareDetail
    {
        get
        {
            var requirements = RequirementsToWorkOn;
            if (requirements.Count == 0)
                return null;

            var names = requirements.Take(3).Select(m => m.Skill);
            var detail = $"{requirements.Count} requirement{(requirements.Count == 1 ? "" : "s")} to work on: {string.Join(", ", names)}";
            if (requirements.Count > 3)
                detail += $" + {requirements.Count - 3} more";

            return detail;
        }
    }

    private static RequirementPriority GetPriority(Job job, string requirementId) =>
        job.JdRequirements.Requirements.FirstOrDefault(r => r.Id == requirementId)?.Priority
        ?? RequirementPriority.NiceToHave;

    private static string GetScoreSubtitle(Job job) =>
        string.IsNullOrWhiteSpace(job.JdRequirements.CompanyName)
            ? "Scored against your master CV"
            : $"{job.JdRequirements.CompanyName} · scored against your master CV";

    // A ChoiceCard's per-status settings: badge, highlight, primary styling and where its
    // action goes. Kept in one place (rather than branching in the markup) so the two cards'
    // configuration per Status is easy to read and change together — see task 016.
    private readonly record struct CardConfig(
        bool IsHighlighted,
        string? BadgeText,
        BadgeTone BadgeTone,
        bool IsPrimary,
        string ActionText,
        string ActionHref);

    private (CardConfig Prepare, CardConfig Tailor) GetCardConfigs(Job job) => job.Status switch
    {
        JobStatus.Preparing => (
            new CardConfig(true, "In progress", BadgeTone.Accent, true, "Continue preparing", $"jobs/{JobId}/prepare"),
            new CardConfig(false, null, BadgeTone.Accent, false, "Tailor my CV", $"jobs/{JobId}/tailor")),

        JobStatus.Tailored => (
            new CardConfig(false, null, BadgeTone.Accent, false, "Prepare for the interview", $"jobs/{JobId}/prepare"),
            new CardConfig(true, "Done", BadgeTone.Success, true, "View tailored CV", $"jobs/{JobId}/cv")),

        _ => (
            new CardConfig(RecommendPrepare, RecommendPrepare ? "Recommended" : null, BadgeTone.Accent, RecommendPrepare, "Start preparing", $"jobs/{JobId}/prepare"),
            new CardConfig(!RecommendPrepare, !RecommendPrepare ? "Recommended" : null, BadgeTone.Accent, !RecommendPrepare, "Tailor my CV", $"jobs/{JobId}/tailor"))
    };

    protected override async Task OnInitializedAsync()
    {
        if (WorkflowState.CurrentJob?.Id != JobId)
        {
            _isLoadingJob = true;
            try
            {
                var job = await JobsApiClient.GetJobByIdAsync(JobId);
                if (job is null)
                {
                    _jobNotFound = true;
                    WorkflowState.CurrentJob = null;
                }
                else
                {
                    WorkflowState.CurrentJob = job;
                }
            }
            catch (Exception ex)
            {
                _jobLoadError = ex.Message;
            }
            finally
            {
                _isLoadingJob = false;
            }
        }

        if (WorkflowState.CurrentJob is not null)
        {
            try
            {
                _cv = await CvApiClient.GetCurrentCvAsync();
            }
            catch
            {
                // Only used for the staleness banner — a transient failure here shouldn't block
                // viewing the score itself, so this fails silently rather than surfacing jobLoadError.
            }
        }
    }
}
