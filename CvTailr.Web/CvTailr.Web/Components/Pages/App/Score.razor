@page "/jobs/{JobId}/score"
@rendermode InteractiveServer

@inject IJobsApiClient JobsApiClient
@inject IScoreApiClient ScoreApiClient
@inject ICvApiClient CvApiClient
@inject WorkflowStateService WorkflowState
@inject NavigationManager NavigationManager

<PageTitle>Score</PageTitle>

<div class="mx-auto max-w-3xl px-4 py-8 space-y-6">
    <h1 class="text-2xl font-semibold text-slate-900">Match score</h1>

    @if (_isLoadingJob)
    {
        <p class="text-sm text-slate-500">Loading job...</p>
    }
    else if (_jobLoadError is not null)
    {
        <div class="rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
            <p class="font-medium">Couldn't load that job.</p>
            <p class="mt-1">@_jobLoadError</p>
        </div>
    }
    else if (WorkflowState.CurrentJob is null)
    {
        <div class="rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
            Job not found.
        </div>
    }
    else
    {
        <button
            @onclick="ScoreAsync"
            disabled="@_isLoading"
            class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500 disabled:cursor-not-allowed disabled:bg-slate-300">
            @(_isLoading ? "Scoring..." : (WorkflowState.CurrentJob.MatchScoreResult is null ? "Get My Score" : "Re-score"))
        </button>

        @if (_isLoading)
        {
            <div class="flex items-center gap-2 text-sm text-slate-500">
                <svg class="h-4 w-4 animate-spin text-indigo-600" viewBox="0 0 24 24" fill="none">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                </svg>
                <span>Scoring your CV against this JD — this may take a moment...</span>
            </div>
        }

        @if (IsScoreStale)
        {
            <div class="rounded-md border border-amber-300 bg-amber-50 p-4 text-sm text-amber-800">
                <p class="font-medium">Your CV has been updated since this job was last scored.</p>
                <p class="mt-1">Recommended: re-score to see how your current CV matches.</p>
            </div>
        }

        @if (_cvMissing)
        {
            <div class="rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
                No CV found for your account yet.
                <NavLink href="cv/upload" class="font-medium text-indigo-600 hover:text-indigo-500">Upload your CV first</NavLink>.
            </div>
        }

        @if (_errorMessage is not null)
        {
            <div class="rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
                <p class="font-medium">Failed to score your CV.</p>
                <p class="mt-1">@_errorMessage</p>
            </div>
        }

        <ScoreResultView Job="WorkflowState.CurrentJob" ShowTailorButton="false" />

        @if (WorkflowState.CurrentJob.MatchScoreResult is not null)
        {
            <section class="mt-8">
                <h2 class="font-space-grotesk text-xl font-semibold text-slate-900">What would you like to do next?</h2>

                <div class="mt-4 grid grid-cols-1 gap-5 md:grid-cols-2">
                    <ChoiceCard Title="Prepare, then tailor"
                                Description="Learn the skills you're missing, prove them in a short assessment, then tailor your CV with evidence you can defend in the interview."
                                Steps="PrepareSteps"
                                Detail="@PrepareDetail"
                                ActionText="Start preparing"
                                ActionHref="@($"jobs/{JobId}/prepare")"
                                IsRecommended="RecommendPrepare"
                                IsPrimary="RecommendPrepare" />

                    <ChoiceCard Title="Tailor now"
                                Description="Go straight to tailored proposals using your CV as it stands. Gaps stay as gaps, and you can still practise for the interview afterwards."
                                Steps="TailorSteps"
                                Detail="Best when your score is already strong or the deadline is close"
                                ActionText="Tailor my CV"
                                ActionHref="@($"jobs/{JobId}/tailor")"
                                IsRecommended="@(!RecommendPrepare)"
                                IsPrimary="@(!RecommendPrepare)" />
                </div>

                <NavLink href="dashboard" class="mt-6 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500">
                    Back to Dashboard
                </NavLink>
            </section>
        }
    }
</div>

@code {
    private static readonly string[] PrepareSteps = ["LEARN", "ASSESS", "CONFIRM", "TAILOR"];
    private static readonly string[] TailorSteps = ["TAILOR", "PRACTISE LATER"];

    [Parameter]
    public string JobId { get; set; } = string.Empty;

    private bool _isLoading;
    private bool _cvMissing;
    private string? _errorMessage;
    private bool _isLoadingJob;
    private string? _jobLoadError;
    private CvDocument? _cv;

    // CvId can't detect a since-replaced CV (the master CvDocument's Id is preserved across
    // re-uploads — see CvTailr.Api/docs/010-cv-reparse-bullet-id-churn.md), so this compares
    // timestamps instead. Informational only — never hides or clears the existing score.
    private bool IsScoreStale =>
        WorkflowState.CurrentJob?.MatchScoreResult is not null
        && _cv is not null
        && _cv.UpdatedAt > WorkflowState.CurrentJob.MatchScoreResult.ScoredAt;

    // "Requirements to work on" = every requirement that's a gap, partially met, or met with
    // confidence below 70% — the model has no separate "partially met" state, so !IsMet covers
    // both gap and partial.
    private List<RequirementMatch> RequirementsToWorkOn =>
        WorkflowState.CurrentJob?.MatchScoreResult?.RequirementMatches
            .Where(m => !m.IsMet || m.Confidence < 70)
            .ToList() ?? [];

    // Recommend preparing first when a Must have requirement isn't fully met, or any met
    // requirement's confidence is below 70% — narrower than RequirementsToWorkOn, which isn't
    // scoped by priority.
    private bool RecommendPrepare
    {
        get
        {
            var job = WorkflowState.CurrentJob;
            if (job?.MatchScoreResult is null)
                return false;

            var mustHaveNotMet = job.MatchScoreResult.RequirementMatches.Any(m =>
                !m.IsMet && GetPriority(job, m.RequirementId) == RequirementPriority.MustHave);
            var metWithLowConfidence = job.MatchScoreResult.RequirementMatches.Any(m => m.IsMet && m.Confidence < 70);

            return mustHaveNotMet || metWithLowConfidence;
        }
    }

    private string? PrepareDetail
    {
        get
        {
            var requirements = RequirementsToWorkOn;
            if (requirements.Count == 0)
                return null;

            var names = requirements.Take(3).Select(m => m.Skill);
            var detail = $"{requirements.Count} requirement{(requirements.Count == 1 ? "" : "s")} to work on: {string.Join(", ", names)}";
            if (requirements.Count > 3)
                detail += $" + {requirements.Count - 3} more";

            return detail;
        }
    }

    private static RequirementPriority GetPriority(Job job, string requirementId) =>
        job.JdRequirements.Requirements.FirstOrDefault(r => r.Id == requirementId)?.Priority
        ?? RequirementPriority.NiceToHave;

    protected override async Task OnInitializedAsync()
    {
        if (WorkflowState.CurrentJob?.Id != JobId)
        {
            _isLoadingJob = true;
            try
            {
                var job = await JobsApiClient.GetJobByIdAsync(JobId);
                if (job is null)
                {
                    _jobLoadError = $"Job '{JobId}' was not found.";
                }
                else
                {
                    WorkflowState.CurrentJob = job;
                }
            }
            catch (Exception ex)
            {
                _jobLoadError = ex.Message;
            }
            finally
            {
                _isLoadingJob = false;
            }
        }

        if (WorkflowState.CurrentJob is not null)
        {
            try
            {
                _cv = await CvApiClient.GetCurrentCvAsync();
            }
            catch
            {
                // Only used for the staleness banner — a transient failure here shouldn't block
                // viewing the score itself, so this fails silently rather than surfacing jobLoadError.
            }
        }
    }

    private async Task ScoreAsync()
    {
        if (WorkflowState.CurrentJob is null)
            return;

        _isLoading = true;
        _errorMessage = null;
        _cvMissing = false;

        try
        {
            var outcome = await ScoreApiClient.GetScoreAsync(WorkflowState.CurrentJob.Id);
            if (outcome.CvMissing)
            {
                _cvMissing = true;
            }
            else if (outcome.JobMissing)
            {
                _errorMessage = $"Job '{WorkflowState.CurrentJob.Id}' was not found.";
            }
            else
            {
                WorkflowState.CurrentJob = outcome.Job;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
