@page "/score"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities

@inject IJobsApiClient JobsApiClient
@inject IScoreApiClient ScoreApiClient
@inject WorkflowStateService WorkflowState
@inject NavigationManager NavigationManager

<PageTitle>Score</PageTitle>

<div class="mx-auto max-w-3xl px-4 py-8 space-y-6">
    <h1 class="text-2xl font-semibold text-slate-900">Match score</h1>

    @if (isLoadingJob)
    {
        <p class="text-sm text-slate-500">Loading job...</p>
    }
    else if (jobLoadError is not null)
    {
        <div class="rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
            <p class="font-medium">Couldn't load that job.</p>
            <p class="mt-1">@jobLoadError</p>
        </div>
    }
    else if (WorkflowState.CurrentJob is null)
    {
        <div class="rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
            You haven't parsed a job description yet this session.
            <NavLink href="jobs/new" class="font-medium text-indigo-600 hover:text-indigo-500">Paste a JD first</NavLink>.
        </div>
    }
    else
    {
        @if (WorkflowState.CurrentJob.MatchScoreResult is null)
        {
            <button
                @onclick="ScoreAsync"
                disabled="@isLoading"
                class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500 disabled:cursor-not-allowed disabled:bg-slate-300">
                @(isLoading ? "Scoring..." : "Get My Score")
            </button>

            @if (isLoading)
            {
                <div class="flex items-center gap-2 text-sm text-slate-500">
                    <svg class="h-4 w-4 animate-spin text-indigo-600" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                    </svg>
                    <span>Scoring your CV against this JD via Azure AI Foundry — this may take a moment...</span>
                </div>
            }
        }

        @if (cvMissing)
        {
            <div class="rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
                No CV found for your account yet.
                <NavLink href="cv/upload" class="font-medium text-indigo-600 hover:text-indigo-500">Upload your CV first</NavLink>.
            </div>
        }

        @if (errorMessage is not null)
        {
            <div class="rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
                <p class="font-medium">Failed to score your CV.</p>
                <p class="mt-1">@errorMessage</p>
            </div>
        }

        <ScoreResultView Job="WorkflowState.CurrentJob" />
    }
</div>

@code {
    private bool isLoading;
    private bool cvMissing;
    private string? errorMessage;
    private bool isLoadingJob;
    private string? jobLoadError;

    protected override async Task OnInitializedAsync()
    {
        // Arrived from the Dashboard's job cards (?jobId=...) — load that specific job
        // into workflow state before anything else, unless it's already the current one.
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var jobId = QueryHelpers.ParseQuery(uri.Query).TryGetValue("jobId", out var jobIdValues)
            ? jobIdValues.ToString()
            : null;

        if (!string.IsNullOrWhiteSpace(jobId) && WorkflowState.CurrentJob?.Id != jobId)
        {
            isLoadingJob = true;
            try
            {
                var job = await JobsApiClient.GetJobByIdAsync(jobId);
                if (job is null)
                {
                    jobLoadError = $"Job '{jobId}' was not found.";
                }
                else
                {
                    WorkflowState.CurrentJob = job;
                }
            }
            catch (Exception ex)
            {
                jobLoadError = ex.Message;
            }
            finally
            {
                isLoadingJob = false;
            }
        }
    }

    private async Task ScoreAsync()
    {
        if (WorkflowState.CurrentJob is null)
            return;

        isLoading = true;
        errorMessage = null;
        cvMissing = false;

        try
        {
            var outcome = await ScoreApiClient.GetScoreAsync(WorkflowState.CurrentJob.Id);
            if (outcome.CvMissing)
            {
                cvMissing = true;
            }
            else
            {
                WorkflowState.CurrentJob = outcome.Job;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
