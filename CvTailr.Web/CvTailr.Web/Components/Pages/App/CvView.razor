@page "/cv/view"
@rendermode InteractiveServer

@inject ApiClient ApiClient

<PageTitle>View CV</PageTitle>

<div class="mx-auto max-w-3xl space-y-6 px-4 py-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900">Your CV</h1>
            <p class="mt-1 text-sm text-slate-600">The full parsed content currently on file.</p>
        </div>

        @if (cv is not null)
        {
            <NavLink href="cv/upload"
               class="inline-flex shrink-0 items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500">
                Replace CV
            </NavLink>
        }
    </div>

    @if (isLoading)
    {
        <p class="text-sm text-slate-500">Loading...</p>
    }
    else if (errorMessage is not null)
    {
        <div class="rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
            <p class="font-medium">Couldn't load your CV.</p>
            <p class="mt-1">@errorMessage</p>
        </div>
    }
    else if (cv is null)
    {
        <div class="rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
            You haven't uploaded a CV yet.
            <NavLink href="cv/upload" class="font-medium text-indigo-600 hover:text-indigo-500">Upload one first</NavLink>.
        </div>
    }
    else
    {
        <div class="space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-semibold text-slate-900">Roles</h2>
            <div class="space-y-4">
                @foreach (var role in cv.Roles)
                {
                    <div class="rounded-md border border-slate-100 p-4">
                        <div class="flex items-baseline justify-between gap-3">
                            <p class="text-sm font-medium text-slate-900">@role.Title · @role.CompanyName</p>
                            <p class="shrink-0 text-xs text-slate-500">@FormatDateRange(role.StartDate, role.EndDate)</p>
                        </div>
                        <ul class="mt-2 list-disc space-y-1 pl-5">
                            @foreach (var bullet in role.Bullets)
                            {
                                <li class="text-sm text-slate-700">
                                    @(bullet.TailoredText ?? bullet.OriginalText)
                                    @if (!string.IsNullOrWhiteSpace(bullet.Language))
                                    {
                                        <span class="ml-1 rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-800">@bullet.Language</span>
                                    }
                                    @if (bullet.IsProvisional)
                                    {
                                        <span class="ml-1 rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-xs font-semibold uppercase tracking-wide text-amber-700">Provisional</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-semibold text-slate-900">Skills</h2>
            @if (cv.Skills.Count == 0)
            {
                <p class="mt-2 text-sm text-slate-500">None detected.</p>
            }
            else
            {
                <div class="mt-2 flex flex-wrap gap-2">
                    @foreach (var skill in cv.Skills)
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-800">
                            @skill.Name
                            @if (skill.IsProvisional)
                            {
                                <span class="rounded-full border border-amber-200 bg-amber-50 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-700">Provisional</span>
                            }
                        </span>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private CvDocument? cv;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cv = await ApiClient.GetCurrentCvAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatDateRange(DateOnly start, DateOnly? end) =>
        $"{start:MMM yyyy} – {(end.HasValue ? end.Value.ToString("MMM yyyy") : "Present")}";
}
