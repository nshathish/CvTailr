@page "/jobs/new"
@rendermode InteractiveServer

@inject IJobsApiClient JobsApiClient
@inject IScoreApiClient ScoreApiClient
@inject WorkflowStateService WorkflowState

<PageTitle>New Job</PageTitle>

<div class="mx-auto max-w-3xl px-4 py-8 space-y-8">
    <WizardStepIndicator CurrentStep="_currentStep" Steps="StepLabels" />

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        @if (_currentStep == 1)
        {
            <h1 class="text-xl font-semibold text-slate-900">Paste a job description</h1>

            <div class="mt-4 inline-flex rounded-[10px] bg-[#F1F2F6] p-1">
                <button
                    type="button"
                    @onclick="@(() => SetMode(JdInputMode.Text))"
                    class="@GetSegmentClass(JdInputMode.Text) rounded-[8px] px-4 py-1.5 text-sm font-medium transition-colors">
                    Paste text
                </button>
                <button
                    type="button"
                    @onclick="@(() => SetMode(JdInputMode.Link))"
                    class="@GetSegmentClass(JdInputMode.Link) rounded-[8px] px-4 py-1.5 text-sm font-medium transition-colors">
                    Paste link
                </button>
            </div>

            <div class="mt-4 space-y-3">
                @if (_inputMode == JdInputMode.Text)
                {
                    <textarea
                        @bind="_jdText"
                        @bind:event="oninput"
                        rows="12"
                        placeholder="Paste the raw job description text here..."
                        class="w-full rounded-md border border-slate-300 p-3 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"></textarea>
                }
                else
                {
                    <div>
                        <input
                            @bind="_jdUrl"
                            @bind:event="oninput"
                            type="url"
                            placeholder="https://company.com/careers/job-title"
                            class="w-full rounded-md border border-slate-300 p-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" />
                        <p class="mt-1.5 text-[13px] text-slate-500">
                            Works best with company career pages. LinkedIn and Indeed often block this, so paste the text instead.
                        </p>
                        <p class="mt-1.5 text-[13px] text-slate-500">
                            Job links you add may be suggested to other users. Nothing about you is shared.
                        </p>

                        @if (_linkErrorKind is not null)
                        {
                            <div class="mt-2 text-[14px] text-[#9F1239]">
                                @if (_linkErrorKind == JdUrlErrorKind.NotAllowed)
                                {
                                    <span>That link can't be used. Check it's a public job page.</span>
                                }
                                else
                                {
                                    <span>We couldn't read that page.</span>
                                    <button type="button" @onclick="SwitchToTextMode" class="ml-1 font-medium underline hover:no-underline">
                                        Paste the text instead
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                <button
                    @onclick="ParseAsync"
                    disabled="@(_isParsing || !CanParse)"
                    class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500 disabled:cursor-not-allowed disabled:bg-slate-300">
                    @(_isParsing ? "Parsing..." : "Parse")
                </button>
            </div>

            @if (_isParsing)
            {
                <div class="mt-4 flex items-center gap-2 text-sm text-slate-500">
                    <Blazicon Svg="Lucide.LoaderCircle" class="h-4 w-4 animate-spin text-indigo-600" aria-hidden="true" />
                    <span>@(_inputMode == JdInputMode.Link ? "Reading the job page…" : "Parsing job description — this may take a moment...")</span>
                </div>
            }

            @if (_parseErrorMessage is not null)
            {
                <div class="mt-4 rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
                    <p class="font-medium">Failed to parse job description.</p>
                    <p class="mt-1">@_parseErrorMessage</p>
                </div>
            }
        }
        else if (_currentStep == 2 && WorkflowState.CurrentJob is not null)
        {
            var jd = WorkflowState.CurrentJob.JdRequirements;

            <h1 class="text-xl font-semibold text-slate-900">Review details</h1>

            <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div>
                    <label class="block text-sm font-medium text-slate-700">Job title</label>
                    <input
                        @bind="_roleTitleInput"
                        @bind:event="oninput"
                        type="text"
                        placeholder="e.g. Senior Software Engineer"
                        class="@GetReviewFieldClass(_roleTitleMissing) mt-1 w-full rounded-md p-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" />
                    @if (_roleTitleMissing)
                    {
                        <p class="mt-1 text-[13px] text-[#92400E]">We couldn't find the job title. Please add it.</p>
                    }
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700">Company name</label>
                    <input
                        @bind="_companyNameInput"
                        @bind:event="oninput"
                        type="text"
                        placeholder="e.g. Acme Corp"
                        class="@GetReviewFieldClass(_companyNameMissing) mt-1 w-full rounded-md p-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" />
                    @if (_companyNameMissing)
                    {
                        <p class="mt-1 text-[13px] text-[#92400E]">We couldn't find the company. Please add it.</p>
                    }
                </div>
            </div>

            <div class="mt-3">
                <label class="block text-sm font-medium text-slate-700">Company website <span class="font-normal text-slate-400">(optional)</span></label>
                <input
                    @bind="_companyDomainInput"
                    @bind:event="oninput"
                    type="text"
                    placeholder="e.g. monzo.com"
                    class="mt-1 w-full rounded-md border border-slate-300 p-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" />
            </div>

            @if (!string.IsNullOrWhiteSpace(WorkflowState.CurrentJob.SourceUrl))
            {
                <p class="mt-2 text-[13px] text-slate-500">
                    Parsed from
                    <a href="@WorkflowState.CurrentJob.SourceUrl" target="_blank" rel="noopener" class="font-medium text-slate-600 underline hover:text-slate-900">@GetHost(WorkflowState.CurrentJob.SourceUrl)</a>
                </p>
            }

            <div class="mt-4 space-y-4">
                <div>
                    <h3 class="text-sm font-medium text-slate-700">Emphasized languages</h3>
                    @if (jd.EmphasizedLanguages.Count == 0)
                    {
                        <p class="mt-1 text-sm text-slate-500">None detected.</p>
                    }
                    else
                    {
                        <div class="mt-1 flex flex-wrap gap-2">
                            @foreach (var language in jd.EmphasizedLanguages)
                            {
                                <span class="rounded-full bg-indigo-100 px-2.5 py-0.5 text-xs font-medium text-indigo-800">@language</span>
                            }
                        </div>
                    }
                </div>

                <div>
                    <h3 class="text-sm font-medium text-slate-700">Requirements</h3>
                    <div class="mt-2 space-y-2">
                        @foreach (var requirement in jd.Requirements)
                        {
                            <div class="flex items-start gap-3 rounded-md border border-slate-100 p-3">
                                <span class="@GetPriorityBadgeClass(requirement.Priority) mt-0.5 shrink-0 rounded-full px-2 py-0.5 text-xs font-medium">
                                    @(requirement.Priority == RequirementPriority.MustHave ? "Must have" : "Nice to have")
                                </span>
                                <div class="min-w-0">
                                    <p class="text-sm font-medium text-slate-900">@requirement.Skill</p>
                                    @if (!string.IsNullOrWhiteSpace(requirement.YearsRequired))
                                    {
                                        <p class="text-xs text-slate-500">@requirement.YearsRequired years</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(requirement.Notes))
                                    {
                                        <p class="mt-1 text-xs text-slate-600">@requirement.Notes</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (_saveDetailsErrorMessage is not null)
            {
                <div class="mt-4 rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
                    <p class="font-medium">@_saveDetailsErrorMessage</p>
                </div>
            }

            <div class="mt-6 flex items-center justify-between">
                <button @onclick="GoBackToStep1" class="text-sm font-medium text-slate-600 hover:text-slate-900">
                    ← Back
                </button>
                <button
                    @onclick="GoToStep3Async"
                    disabled="@(!CanContinueFromReview || _isSavingDetails)"
                    class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500 disabled:cursor-not-allowed disabled:bg-slate-300">
                    @(_isSavingDetails ? "Saving…" : "Continue")
                </button>
            </div>
        }
        else if (_currentStep == 3 && WorkflowState.CurrentJob is not null)
        {
            <h1 class="text-xl font-semibold text-slate-900">Match &amp; score</h1>

            @if (_isScoring)
            {
                <div class="mt-4 flex items-center gap-2 text-sm text-slate-500">
                    <Blazicon Svg="Lucide.LoaderCircle" class="h-4 w-4 animate-spin text-indigo-600" aria-hidden="true" />
                    <span>Scoring your CV against this JD — this may take a moment...</span>
                </div>
            }

            @if (_cvMissing)
            {
                <div class="mt-4 rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
                    No CV found for your account yet.
                    <NavLink href="cv/upload" class="font-medium text-indigo-600 hover:text-indigo-500">Upload your CV first</NavLink>.
                    <button
                        @onclick="RetryScoreAsync"
                        disabled="@_isScoring"
                        class="ml-3 inline-flex items-center rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-400">
                        Check again
                    </button>
                </div>
            }

            @if (_scoreErrorMessage is not null)
            {
                <div class="mt-4 rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
                    <p class="font-medium">Failed to score your CV.</p>
                    <p class="mt-1">@_scoreErrorMessage</p>
                    <button
                        @onclick="RetryScoreAsync"
                        disabled="@_isScoring"
                        class="mt-3 inline-flex items-center rounded-md border border-red-300 bg-white px-3 py-1.5 text-sm font-medium text-red-700 shadow-sm hover:bg-red-100 disabled:cursor-not-allowed disabled:bg-red-50 disabled:text-red-400">
                        Retry
                    </button>
                </div>
            }

            @if (WorkflowState.CurrentJob.MatchScoreResult is not null)
            {
                <div class="mt-4">
                    <ScoreResultView Job="WorkflowState.CurrentJob">
                        <ExtraActions>
                            <NavLink href="dashboard" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">
                                Back to Dashboard
                            </NavLink>
                        </ExtraActions>
                    </ScoreResultView>
                </div>
            }
        }
    </div>
</div>

@code {
    private static readonly string[] StepLabels = ["Paste JD", "Review details", "Match & score"];

    private enum JdInputMode { Text, Link }

    private int _currentStep = 1;
    private JdInputMode _inputMode = JdInputMode.Text;
    private string _jdText = string.Empty;
    private string _jdUrl = string.Empty;
    private bool _isParsing;
    private string? _parseErrorMessage;
    private JdUrlErrorKind? _linkErrorKind;
    private string _roleTitleInput = string.Empty;
    private string _companyNameInput = string.Empty;
    private string _companyDomainInput = string.Empty;
    private bool _roleTitleMissing;
    private bool _companyNameMissing;
    private bool _isSavingDetails;
    private string? _saveDetailsErrorMessage;
    private bool _isScoring;
    private bool _cvMissing;
    private string? _scoreErrorMessage;
    private bool _hasTriggeredScoring;

    private bool CanParse => _inputMode switch
    {
        JdInputMode.Text => !string.IsNullOrWhiteSpace(_jdText),
        JdInputMode.Link => !string.IsNullOrWhiteSpace(_jdUrl) &&
                             (_jdUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                              _jdUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)),
        _ => false
    };

    private bool CanContinueFromReview =>
        !string.IsNullOrWhiteSpace(_roleTitleInput) && !string.IsNullOrWhiteSpace(_companyNameInput);

    private void SetMode(JdInputMode mode)
    {
        if (_inputMode == mode)
            return;

        _inputMode = mode;
        _linkErrorKind = null;
        _parseErrorMessage = null;
    }

    private void SwitchToTextMode() => SetMode(JdInputMode.Text);

    private string GetSegmentClass(JdInputMode mode) => mode == _inputMode
        ? "bg-white text-[#4A3FD0] shadow-sm"
        : "text-slate-500 hover:text-slate-700";

    private static string GetReviewFieldClass(bool isMissing) => isMissing
        ? "border border-[#F59E0B]"
        : "border border-slate-300";

    private static string GetHost(string url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri) ? uri.Host : url;

    private async Task ParseAsync()
    {
        if (!CanParse)
            return;

        _isParsing = true;
        _parseErrorMessage = null;
        _linkErrorKind = null;

        try
        {
            var jdText = _inputMode == JdInputMode.Text ? _jdText : null;
            var jdUrl = _inputMode == JdInputMode.Link ? _jdUrl.Trim() : null;

            var outcome = await JobsApiClient.ParseJdAsync(jdText, jdUrl);
            if (outcome.UrlError is not null)
            {
                _linkErrorKind = outcome.UrlError;
                return;
            }

            var job = outcome.Job!;
            WorkflowState.CurrentJob = job;
            _roleTitleInput = job.JdRequirements.RoleTitle ?? string.Empty;
            _companyNameInput = job.JdRequirements.CompanyName ?? string.Empty;
            _companyDomainInput = job.JdRequirements.CompanyDomain ?? string.Empty;
            _roleTitleMissing = string.IsNullOrWhiteSpace(_roleTitleInput);
            _companyNameMissing = string.IsNullOrWhiteSpace(_companyNameInput);
            _currentStep = 2;
        }
        catch (Exception ex)
        {
            _parseErrorMessage = ex.Message;
        }
        finally
        {
            _isParsing = false;
        }
    }

    private void GoBackToStep1() => _currentStep = 1;

    private async Task GoToStep3Async()
    {
        if (WorkflowState.CurrentJob is null || !CanContinueFromReview || _isSavingDetails)
            return;

        _isSavingDetails = true;
        _saveDetailsErrorMessage = null;

        try
        {
            var companyDomain = _companyDomainInput.Trim();
            WorkflowState.CurrentJob = await JobsApiClient.UpdateJobDetailsAsync(
                WorkflowState.CurrentJob.Id,
                _roleTitleInput.Trim(),
                _companyNameInput.Trim(),
                string.IsNullOrEmpty(companyDomain) ? null : companyDomain);

            // The Api normalises CompanyDomain (may differ from what was typed) — reflect that if
            // the user comes back to this step (e.g. via "Back" from step 3).
            _companyDomainInput = WorkflowState.CurrentJob.JdRequirements.CompanyDomain ?? string.Empty;
        }
        catch (Exception)
        {
            _saveDetailsErrorMessage = "We couldn't save these details. Please try again.";
            return;
        }
        finally
        {
            _isSavingDetails = false;
        }

        _currentStep = 3;

        if (WorkflowState.CurrentJob.MatchScoreResult is null)
        {
            _hasTriggeredScoring = false;
            await ScoreAsync();
        }
    }

    private async Task ScoreAsync()
    {
        if (WorkflowState.CurrentJob is null || _hasTriggeredScoring)
            return;

        _hasTriggeredScoring = true;
        _isScoring = true;
        _cvMissing = false;
        _scoreErrorMessage = null;

        try
        {
            var outcome = await ScoreApiClient.GetScoreAsync(WorkflowState.CurrentJob.Id);
            if (outcome.CvMissing)
            {
                _cvMissing = true;
                _hasTriggeredScoring = false;
            }
            else if (outcome.JobMissing)
            {
                _scoreErrorMessage = $"Job '{WorkflowState.CurrentJob.Id}' was not found.";
            }
            else
            {
                WorkflowState.CurrentJob = outcome.Job;
            }
        }
        catch (Exception ex)
        {
            _scoreErrorMessage = ex.Message;
            _hasTriggeredScoring = false;
        }
        finally
        {
            _isScoring = false;
        }
    }

    private Task RetryScoreAsync()
    {
        _hasTriggeredScoring = false;
        return ScoreAsync();
    }

    private static string GetPriorityBadgeClass(RequirementPriority priority) => priority switch
    {
        RequirementPriority.MustHave => "bg-red-100 text-red-800",
        RequirementPriority.NiceToHave => "bg-emerald-100 text-emerald-800",
        _ => "bg-slate-100 text-slate-800"
    };
}
