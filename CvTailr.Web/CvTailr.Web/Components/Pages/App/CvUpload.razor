@page "/cv/upload"
@rendermode InteractiveServer
@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@implements IAsyncDisposable

@inject ICvApiClient CvApiClient
@inject WorkflowStateService WorkflowState
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

<PageTitle>Upload CV</PageTitle>

<div class="mx-auto max-w-2xl space-y-6 px-4 py-8">
    <div>
        <h1 class="text-2xl font-semibold text-slate-900">Upload CV</h1>
        <p class="mt-1 text-sm text-slate-600">This powers the match score and tailored suggestions.</p>
    </div>

    @if (_redirectedForMissingCv)
    {
        <div class="rounded-md border border-indigo-200 bg-indigo-50 p-4 text-sm text-indigo-800">
            Upload your CV first to start matching it against job descriptions.
        </div>
    }

    @if (_isCheckingExisting)
    {
        <p class="text-sm text-slate-500">Loading...</p>
    }
    else
    {
        <div class="space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="text-sm font-semibold text-slate-900">Upload a CV file (.pdf, .docx, .txt, .tex)</h2>

            <label @ref="_dropZoneElement" class="group relative flex cursor-pointer flex-col items-center justify-center rounded-lg border-2 border-dashed border-slate-300 px-6 py-10 text-center transition-colors hover:border-indigo-400 hover:bg-indigo-50/40">
                <InputFile OnChange="OnFileSelected" accept=".pdf,.docx,.txt,.tex" class="sr-only" />
                <svg class="h-8 w-8 text-slate-400 transition-colors group-hover:text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 8.25L12 3.75m0 0L7.5 8.25M12 3.75v12" />
                </svg>
                <p class="mt-3 text-sm font-semibold text-slate-900">Click to choose a file, or drag and drop it here</p>
                <p class="mt-1 text-xs text-slate-500">or paste your CV text below</p>
            </label>

            @if (_selectedFile is not null)
            {
                <div class="flex items-center justify-between text-sm text-slate-500">
                    <span>Selected: @_selectedFile.Name (@FormatSize(_selectedFile.Size))</span>
                    <button type="button" @onclick="ClearSelectedFile" class="text-xs font-medium text-slate-500 hover:text-slate-700">
                        Clear
                    </button>
                </div>
            }

            @if (_validationError is not null)
            {
                <p class="text-sm text-red-600">@_validationError</p>
            }

            <div>
                <label for="pasteCvText" class="block text-sm font-medium text-slate-700">Paste CV text</label>
                <textarea id="pasteCvText"
                    value="@_pastedText"
                    @oninput="OnPastedTextChanged"
                    disabled="@(_selectedFile is not null)"
                    rows="8"
                    placeholder="Paste your CV text here..."
                    class="mt-1 w-full rounded-md border border-slate-300 p-3 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 disabled:bg-slate-50 disabled:text-slate-400"></textarea>
            </div>

            <button
                @onclick="UploadAsync"
                disabled="@(_isLoading || !CanUpload)"
                class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500 disabled:cursor-not-allowed disabled:bg-slate-300">
                @(_isLoading ? "Saving..." : "Save CV")
            </button>

            @if (_isLoading)
            {
                <div class="flex items-center gap-2 text-sm text-slate-500">
                    <svg class="h-4 w-4 animate-spin text-indigo-600" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                    </svg>
                    <span>Parsing CV...</span>
                </div>
            }

            @if (_errorMessage is not null)
            {
                <div class="rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
                    <p class="font-medium">Failed to parse CV.</p>
                    <p class="mt-1">@_errorMessage</p>
                </div>
            }
        </div>

        @if (_parsedCv is not null)
        {
            <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="text-sm font-semibold text-slate-900">Current CV</h2>
                <dl class="mt-3 divide-y divide-slate-100 text-sm">
                    <div class="flex items-center justify-between py-2">
                        <dt class="text-slate-500">Source</dt>
                        <dd class="font-medium text-slate-900">@CurrentCvSourceDisplay</dd>
                    </div>
                    <div class="flex items-center justify-between py-2">
                        <dt class="text-slate-500">Saved</dt>
                        <dd class="font-medium text-slate-900">@CurrentCvSavedDisplay</dd>
                    </div>
                    <div class="flex items-center justify-between py-2">
                        <dt class="text-slate-500">Skills detected</dt>
                        <dd class="font-medium text-slate-900">@_parsedCv.Skills.Count</dd>
                    </div>
                </dl>
            </div>
        }
    }
</div>

@code {
    // Matches the API's request size expectations (see tasks/003-cv-upload-page.md).
    private const long MaxFileSizeBytes = 2 * 1024 * 1024;

    private bool _isCheckingExisting = true;
    private bool _redirectedForMissingCv;
    private ElementReference _dropZoneElement;
    private IJSObjectReference? _dragDropModule;
    private bool _dragDropBound;
    private IBrowserFile? _selectedFile;
    private string _pastedText = string.Empty;
    private string? _validationError;
    private bool _isLoading;
    private string? _errorMessage;
    private CvDocument? _parsedCv;

    // No source/filename field is persisted anywhere (CvDocument has no such field), so this
    // only reflects an upload/replace performed in this session; an existing CV loaded on page
    // arrival falls back to the placeholder below.
    private string? _currentCvSourceLabel;

    private bool CanUpload => (_selectedFile is not null && _validationError is null)
        || !string.IsNullOrWhiteSpace(_pastedText);

    private string CurrentCvSourceDisplay => _currentCvSourceLabel ?? "Uploaded CV";

    private string CurrentCvSavedDisplay => _parsedCv is not null
        ? _parsedCv.UpdatedAt.ToLocalTime().ToString("d MMM yyyy, h:mm tt")
        : "Unknown";

    protected override async Task OnInitializedAsync()
    {
        // Only show the "you were sent here" banner when Dashboard actually redirected here for
        // a missing CV (?reason=required) — never for a user who navigated to this page directly.
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        _redirectedForMissingCv = QueryHelpers.ParseQuery(uri.Query).TryGetValue("reason", out var reasonValues)
            && reasonValues.ToString() == "required";

        try
        {
            var existing = await CvApiClient.GetCurrentCvAsync();
            if (existing is not null)
            {
                _parsedCv = existing;
                WorkflowState.CurrentCv = existing;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isCheckingExisting = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The drop zone only exists once isCheckingExisting flips false, which is never true on
        // the very first render (OnInitializedAsync's "Loading..." branch renders first) — so
        // bind lazily the first render after that, rather than gating on firstRender.
        if (_dragDropBound || _isCheckingExisting)
        {
            return;
        }

        _dragDropBound = true;
        _dragDropModule = await JsRuntime.InvokeAsync<IJSObjectReference>(
            "import", "./Components/Pages/App/CvUpload.razor.js");
        await _dragDropModule.InvokeVoidAsync("bindDropZone", _dropZoneElement);
    }

    private static readonly string[] SupportedExtensions = [".pdf", ".docx", ".txt", ".tex"];

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        _selectedFile = e.File;
        _pastedText = string.Empty;

        if (!SupportedExtensions.Any(ext => _selectedFile.Name.EndsWith(ext, StringComparison.OrdinalIgnoreCase)))
        {
            _validationError = $"Only {string.Join(", ", SupportedExtensions)} files are supported.";
        }
        else if (_selectedFile.Size > MaxFileSizeBytes)
        {
            _validationError = $"File is too large ({FormatSize(_selectedFile.Size)}). Maximum size is {FormatSize(MaxFileSizeBytes)}.";
        }
        else
        {
            _validationError = null;
        }
    }

    private void ClearSelectedFile()
    {
        _selectedFile = null;
        _validationError = null;
    }

    private void OnPastedTextChanged(ChangeEventArgs e)
    {
        _pastedText = e.Value?.ToString() ?? string.Empty;

        // Avoid ambiguous double-submission: typing a paste clears any file selection, so
        // whichever input method has content wins with no leftover state from the other.
        if (!string.IsNullOrWhiteSpace(_pastedText))
        {
            _selectedFile = null;
            _validationError = null;
        }
    }

    private async Task UploadAsync()
    {
        if (!CanUpload)
            return;

        _isLoading = true;
        _errorMessage = null;

        try
        {
            CvDocument result;
            string sourceLabel;

            if (_selectedFile is not null)
            {
                using var stream = _selectedFile.OpenReadStream(MaxFileSizeBytes);
                result = await CvApiClient.ParseCvAsync(stream, _selectedFile.Name, rawCvText: null);
                sourceLabel = _selectedFile.Name;
            }
            else
            {
                if (Encoding.UTF8.GetByteCount(_pastedText) > MaxFileSizeBytes)
                {
                    _errorMessage = $"Pasted text is too large. Maximum size is {FormatSize(MaxFileSizeBytes)}.";
                    return;
                }

                result = await CvApiClient.ParseCvAsync(fileStream: null, fileName: null, _pastedText);
                sourceLabel = "Pasted text";
            }

            _parsedCv = result;
            WorkflowState.CurrentCv = result;
            _currentCvSourceLabel = sourceLabel;
            _selectedFile = null;
            _pastedText = string.Empty;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024.0):0.#} MB"
    };

    public async ValueTask DisposeAsync()
    {
        if (_dragDropModule is null)
        {
            return;
        }

        try
        {
            await _dragDropModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already torn down — nothing left to clean up.
        }
    }
}
