@page "/cv/upload"
@rendermode InteractiveServer
@using System.Text

@inject ApiClient ApiClient
@inject WorkflowStateService WorkflowState

<PageTitle>Upload CV</PageTitle>

<div class="mx-auto max-w-2xl space-y-6 px-4 py-8">
    <div>
        <h1 class="text-2xl font-semibold text-slate-900">Upload CV</h1>
        <p class="mt-1 text-sm text-slate-600">This powers the match score and tailored suggestions.</p>
    </div>

    @if (isCheckingExisting)
    {
        <p class="text-sm text-slate-500">Loading...</p>
    }
    else
    {
        <div class="space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="text-sm font-semibold text-slate-900">Upload a CV file (.tex)</h2>

            <label class="group relative flex cursor-pointer flex-col items-center justify-center rounded-lg border-2 border-dashed border-slate-300 px-6 py-10 text-center transition-colors hover:border-indigo-400 hover:bg-indigo-50/40">
                <InputFile OnChange="OnFileSelected" accept=".tex" class="sr-only" />
                <svg class="h-8 w-8 text-slate-400 transition-colors group-hover:text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 8.25L12 3.75m0 0L7.5 8.25M12 3.75v12" />
                </svg>
                <p class="mt-3 text-sm font-semibold text-slate-900">Click to choose a file</p>
                <p class="mt-1 text-xs text-slate-500">or paste your CV text below</p>
            </label>

            @if (selectedFile is not null)
            {
                <div class="flex items-center justify-between text-sm text-slate-500">
                    <span>Selected: @selectedFile.Name (@FormatSize(selectedFile.Size))</span>
                    <button type="button" @onclick="ClearSelectedFile" class="text-xs font-medium text-slate-500 hover:text-slate-700">
                        Clear
                    </button>
                </div>
            }

            @if (validationError is not null)
            {
                <p class="text-sm text-red-600">@validationError</p>
            }

            <div>
                <label for="pasteCvText" class="block text-sm font-medium text-slate-700">Paste CV text</label>
                <textarea id="pasteCvText"
                    value="@pastedText"
                    @oninput="OnPastedTextChanged"
                    disabled="@(selectedFile is not null)"
                    rows="8"
                    placeholder="Paste your CV's LaTeX source here..."
                    class="mt-1 w-full rounded-md border border-slate-300 p-3 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 disabled:bg-slate-50 disabled:text-slate-400"></textarea>
            </div>

            <button
                @onclick="UploadAsync"
                disabled="@(isLoading || !CanUpload)"
                class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500 disabled:cursor-not-allowed disabled:bg-slate-300">
                @(isLoading ? "Saving..." : "Save CV")
            </button>

            @if (isLoading)
            {
                <div class="flex items-center gap-2 text-sm text-slate-500">
                    <svg class="h-4 w-4 animate-spin text-indigo-600" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                    </svg>
                    <span>Parsing CV...</span>
                </div>
            }

            @if (errorMessage is not null)
            {
                <div class="rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
                    <p class="font-medium">Failed to parse CV.</p>
                    <p class="mt-1">@errorMessage</p>
                </div>
            }
        </div>

        @if (parsedCv is not null)
        {
            <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="text-sm font-semibold text-slate-900">Current CV</h2>
                <dl class="mt-3 divide-y divide-slate-100 text-sm">
                    <div class="flex items-center justify-between py-2">
                        <dt class="text-slate-500">Source</dt>
                        <dd class="font-medium text-slate-900">@CurrentCvSourceDisplay</dd>
                    </div>
                    <div class="flex items-center justify-between py-2">
                        <dt class="text-slate-500">Saved</dt>
                        <dd class="font-medium text-slate-900">@CurrentCvSavedDisplay</dd>
                    </div>
                    <div class="flex items-center justify-between py-2">
                        <dt class="text-slate-500">Skills detected</dt>
                        <dd class="font-medium text-slate-900">@parsedCv.Skills.Count</dd>
                    </div>
                </dl>
            </div>
        }
    }
</div>

@code {
    // Matches the API's request size expectations (see tasks/003-cv-upload-page.md).
    private const long MaxFileSizeBytes = 2 * 1024 * 1024;

    private bool isCheckingExisting = true;
    private IBrowserFile? selectedFile;
    private string pastedText = string.Empty;
    private string? validationError;
    private bool isLoading;
    private string? errorMessage;
    private CvDocument? parsedCv;

    // Neither a source label nor a save timestamp is persisted anywhere (CvDocument has no
    // such fields, and /api/cv/parse doesn't accept a filename) — these only reflect an
    // upload/replace performed in this session; an existing CV loaded on page arrival falls
    // back to the placeholders below.
    private string? currentCvSourceLabel;
    private DateTimeOffset? currentCvSavedAt;

    private bool CanUpload => (selectedFile is not null && validationError is null)
        || !string.IsNullOrWhiteSpace(pastedText);

    private string CurrentCvSourceDisplay => currentCvSourceLabel ?? "Uploaded CV";

    private string CurrentCvSavedDisplay => currentCvSavedAt.HasValue
        ? currentCvSavedAt.Value.ToLocalTime().ToString("d MMM yyyy, h:mm tt")
        : "Unknown";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var existing = await ApiClient.GetCurrentCvAsync();
            if (existing is not null)
            {
                parsedCv = existing;
                WorkflowState.CurrentCv = existing;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isCheckingExisting = false;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        selectedFile = e.File;
        pastedText = string.Empty;

        if (!selectedFile.Name.EndsWith(".tex", StringComparison.OrdinalIgnoreCase))
        {
            validationError = "Only .tex files are supported.";
        }
        else if (selectedFile.Size > MaxFileSizeBytes)
        {
            validationError = $"File is too large ({FormatSize(selectedFile.Size)}). Maximum size is {FormatSize(MaxFileSizeBytes)}.";
        }
        else
        {
            validationError = null;
        }
    }

    private void ClearSelectedFile()
    {
        selectedFile = null;
        validationError = null;
    }

    private void OnPastedTextChanged(ChangeEventArgs e)
    {
        pastedText = e.Value?.ToString() ?? string.Empty;

        // Avoid ambiguous double-submission: typing a paste clears any file selection, so
        // whichever input method has content wins with no leftover state from the other.
        if (!string.IsNullOrWhiteSpace(pastedText))
        {
            selectedFile = null;
            validationError = null;
        }
    }

    private async Task UploadAsync()
    {
        if (!CanUpload)
            return;

        isLoading = true;
        errorMessage = null;

        try
        {
            string rawLatexSource;
            string sourceLabel;

            if (selectedFile is not null)
            {
                using var reader = new StreamReader(selectedFile.OpenReadStream(MaxFileSizeBytes));
                rawLatexSource = await reader.ReadToEndAsync();
                sourceLabel = selectedFile.Name;
            }
            else
            {
                if (Encoding.UTF8.GetByteCount(pastedText) > MaxFileSizeBytes)
                {
                    errorMessage = $"Pasted text is too large. Maximum size is {FormatSize(MaxFileSizeBytes)}.";
                    return;
                }

                rawLatexSource = pastedText;
                sourceLabel = "Pasted text";
            }

            var result = await ApiClient.ParseCvAsync(rawLatexSource);
            parsedCv = result;
            WorkflowState.CurrentCv = result;
            currentCvSourceLabel = sourceLabel;
            currentCvSavedAt = DateTimeOffset.UtcNow;
            selectedFile = null;
            pastedText = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024.0):0.#} MB"
    };
}
