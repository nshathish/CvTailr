@page "/jobs/{JobId}/prepare"

<PageTitle>Prepare</PageTitle>

<div class="mx-auto max-w-3xl px-4 py-8">
    <div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
        <h1 class="text-xl font-semibold text-slate-900">Preparation is on its way</h1>
        <p class="mt-2 text-sm text-slate-600">
            The prepare hub for learning, assessing, and confirming skills before tailoring isn't built yet.
        </p>
        <NavLink href="@($"jobs/{JobId}/score")" class="mt-6 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500">
            Back to score
        </NavLink>
    </div>
</div>

@code {
    [Parameter]
    public string JobId { get; set; } = string.Empty;
}
