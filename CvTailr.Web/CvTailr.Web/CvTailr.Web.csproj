<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CVTailr.Shared\CVTailr.Shared\CVTailr.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageReference Include="Microsoft.Identity.Web.DownstreamApi" Version="4.14.2" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.14.2" />
  </ItemGroup>

  <!--
    Builds wwwroot/css/app.css from the Tailwind source (Styles/app.css) before
    Build/Publish, so the committed CSS doesn't silently go stale relative to
    .razor markup. Skips (with a warning, not a failure) when node_modules is
    absent, so a CI/deploy environment without Node still builds - it just uses
    whatever wwwroot/css/app.css is already committed.
  -->
  <Target Name="BuildTailwindCss" BeforeTargets="Build;Publish" Condition="'$(_TailwindCssBuilt)' != 'true'">
    <PropertyGroup>
      <_TailwindCssBuilt>true</_TailwindCssBuilt>
    </PropertyGroup>
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="Exists('$(MSBuildProjectDirectory)\node_modules')" />
    <Warning Text="node_modules not found - skipping Tailwind CSS build. wwwroot/css/app.css may be stale; run 'npm install' then 'npm run build:css' in CvTailr.Web/CvTailr.Web/." Condition="!Exists('$(MSBuildProjectDirectory)\node_modules')" />
  </Target>

</Project>
